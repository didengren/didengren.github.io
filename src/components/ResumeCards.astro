---
import profile from '../data/profile.json';
import resumes from '../data/resumes.json';
import { withBase } from '../utils/path';
---

<div class="resume-grid">
  {resumes.map((resume) => (
    <div class={`card resume-card${resume.primary ? ' resume-card--primary' : ' resume-card--secondary'}`}>
      <div class="card-k">{resume.file ? 'PDF' : resume.primary ? 'PRIMARY / 主投' : 'OPTIONAL / 备选'}</div>
      <h3>{resume.label}</h3>
      <p>{resume.description}</p>
      <p class="resume-for">适合：{resume.recommendedFor}</p>
      {resume.file ? (
        <a
          class="btn resume-btn"
          href={withBase(resume.file)}
          download
          data-umami-event="resume_download"
        >
          下载 PDF
        </a>
      ) : (
        <a
          class="btn resume-btn"
          href={`mailto:${profile.email}?subject=请发一份${resume.label}简历`}
          data-umami-event="resume_request"
        >
          {resume.primary ? '邮件索取' : '邮件索取（备选）'}
        </a>
      )}
    </div>
  ))}
</div>

<p class="note resume-note">
  PDF 通过邮件发送：产品经理版为主投，前端经理版仅在前端管理方向沟通时提供。
</p>
