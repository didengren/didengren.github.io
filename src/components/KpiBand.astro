---
import impact from '../data/impact.json';
---

<section class="kpis" aria-label="关键数字">
  <div class="wrap kpis-in">
    {impact.map((item) => (
      <div class="kpi">
        <div class="kpi-n">{item.value}<u>{item.unit}</u></div>
        <div class="kpi-l">{item.label}</div>
        <div class="kpi-d">{item.context}</div>
        <div class="kpi-bar"></div>
      </div>
    ))}
  </div>
</section>
