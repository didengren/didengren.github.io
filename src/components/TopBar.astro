---
import profile from '../data/profile.json';

const path = Astro.url.pathname;
const items = [
  { href: '/', label: '首页' },
  { href: '/work/', label: '作品' },
  { href: '/experience/', label: '经历' },
  { href: '/about/', label: '关于' },
  { href: '/contact/', label: '联系' },
];

const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href.replace(/\/$/, ''));
---

<header class="top">
  <div class="wrap top-bar">
    <a class="brand" href="/">徐念祖<span>SAM XU</span></a>

    <nav class="nav" aria-label="主导航">
      {items.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="top-right">
      <a class="top-cta" href="/contact/#resume" data-umami-event="resume_request">简历</a>
      <div class="status"><i></i>{profile.availability}</div>
      <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-nav" data-menu-btn>
        菜单
      </button>
    </div>
  </div>

  <nav class="mobile-nav" id="mobile-nav" aria-label="移动导航">
    {items.map((item) => <a href={item.href}>{item.label}</a>)}
    <a href="/contact/#resume" data-umami-event="resume_request">简历</a>
  </nav>
</header>
