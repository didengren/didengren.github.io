---
import profile from '../data/profile.json';
import { withBase } from '../utils/path';

const path = Astro.url.pathname;
const home = withBase('/');

const items = [
  { href: home, label: '首页' },
  { href: withBase('/work/'), label: '案例' },
  { href: withBase('/experience/'), label: '经历' },
  { href: withBase('/about/'), label: '关于' },
  { href: withBase('/contact/'), label: '联系' },
];

const isActive = (href: string) =>
  href === home ? path === home : path.startsWith(href.replace(/\/$/, ''));
---

<header class="top">
  <div class="wrap top-bar">
    <a class="brand" href={home}>徐念祖<span>SAM XU</span></a>

    <nav class="nav" aria-label="主导航">
      {items.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))}
    </nav>

    <div class="top-right">
      <a class="top-cta" href={withBase('/contact/#resume')} data-umami-event="resume_request">简历</a>
      <div class="status"><i></i>{profile.availability}</div>
      <button
        class="menu-btn"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="菜单"
        data-menu-btn
      >
        <span class="menu-label" aria-hidden="true">
          <span class="menu-label-open">菜单</span>
          <span class="menu-label-close">关闭</span>
        </span>
        <span class="menu-sign" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <nav class="mobile-nav" id="mobile-nav" aria-label="移动导航">
    <div class="mobile-nav-inner">
      {items.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
      <a href={withBase('/contact/#resume')} data-umami-event="resume_request">简历</a>
      <p class="mobile-status"><i></i>{profile.availability} · {profile.location}</p>
    </div>
  </nav>
</header>
