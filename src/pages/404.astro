---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="404｜徐念祖 Sam Xu"
  description="页面不存在。回到首页或查看案例。"
  noindex
>
  <div class="wrap">
    <section class="notfound">
      <p class="kicker">404 / NOT FOUND</p>
      <h1>这个页面<br /><em>不在图纸上。</em></h1>
      <p class="page-lead">链接可能已经过期，或者地址输错了。</p>
      <div class="actions">
        <a class="btn" href="/">回首页</a>
        <a class="link" href="/work/">看案例</a>
      </div>
    </section>
  </div>
</BaseLayout>
