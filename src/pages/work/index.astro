---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseRow from '../../components/CaseRow.astro';
import ContactBlock from '../../components/ContactBlock.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const flagship = projects.filter((project) => project.data.featured);
const supporting = projects.filter((project) => !project.data.featured);
---

<BaseLayout
  title="案例｜徐念祖 Sam Xu"
  description="五个真实项目：户用光伏统一入口平台、跨系统 AI 工作入口、代理商移动作业 App、分布式光伏 CRM、仓配物流系统。"
  ogDescription="从 0→1、跨系统入口整合到 AI 产品：每个案例只讲问题、取舍与结果。"
>
  <div class="wrap">
    <header class="page-head">
      <p class="kicker">WORK / {projects.length} CASES</p>
      <h1 class="page-title">案例</h1>
      <p class="page-lead">
        三个旗舰案例，分别回答 0→1、跨系统整合与 AI 边界；两个存量改造，回答如何在不动大架构的前提下把机制修好。
        每个案例只讲问题、取舍与结果。
      </p>
    </header>

    <section>
      <div class="section-head">
        <h2>旗舰案例</h2>
        <span class="en">FLAGSHIP / {String(flagship.length).padStart(2, '0')}</span>
      </div>

      {flagship.map((project, index) => (
        <CaseRow project={project} index={index + 1} />
      ))}
    </section>

    <section>
      <div class="section-head">
        <h2>存量改造</h2>
        <span class="en">RENOVATION / {String(supporting.length).padStart(2, '0')}</span>
      </div>

      {supporting.map((project, index) => (
        <CaseRow project={project} index={flagship.length + index + 1} />
      ))}

      <p class="note section-more">
        案例只讲决策与机制；隐去客户名、内部截图与明细数据。没有可公开口径的数字不补。
      </p>
    </section>
  </div>

  <ContactBlock />
</BaseLayout>
